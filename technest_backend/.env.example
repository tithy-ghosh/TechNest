PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000


DATABASE_URL=postgresql://user:password@host:5432/technest?sslmode=require&schema=public


JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_refresh_secret

STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Email — Brevo SMTP (free plan: 300 emails/day)
# 1. Create a free account at https://www.brevo.com
# 2. Verify a sender under Settings → Senders & IP → Senders
# 3. Copy the SMTP login and generate an SMTP key under Settings → SMTP & API → SMTP
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_brevo_login_email
SMTP_PASS=your_brevo_smtp_key
# Must match the sender verified in Brevo.
EMAIL_FROM=TechNest <your_verified_sender@example.com>

# Alternative: Resend. Only used when EMAIL_PROVIDER=resend (or when no SMTP
# credentials are set). Without a verified domain, Resend only delivers to the
# Resend account owner's address.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_your_resend_api_key
# EMAIL_FROM=TechNest <onboarding@resend.dev>

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

OPENROUTER_API_KEY=your_openrouter_key
